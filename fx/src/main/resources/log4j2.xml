<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="com.github.exadmin.cyberferret.fxui.logger">
    <Appenders>
        <!--<Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] [%tid] %-5level %logger{36} - %msg%n"/>
        </Console>

        <File name="File" fileName="./logs2.log" append="true">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] [%tid] %-5level %logger{36} - %msg%n"/>
        </File>-->

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level: %msg%n"/>
        </Console>

        <RollingFile name="File"
                     fileName="${sys:user.home}/.qubership/logs/cyberferret.log"
                     filePattern="${sys:user.home}/.qubership/logs/cyberferret-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level: %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10">
                <Delete basePath="${sys:user.home}/.qubership/logs" maxDepth="1">
                    <IfFileName glob="cyberferret-*.log.gz">
                        <IfAccumulatedFileCount exceeds="10"/>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <FXConsoleAppender name="FXConsoleAppender">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level: %msg%n"/>
        </FXConsoleAppender>
    </Appenders>
    <Loggers>
        <Logger name="org.apache" level="INFO"/>
        <Logger name="com.github.exadmin.cyberferret" level="INFO" additivity="true">
            <AppenderRef ref="FXConsoleAppender"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
